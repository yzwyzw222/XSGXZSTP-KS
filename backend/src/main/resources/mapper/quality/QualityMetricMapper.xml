<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aacv.system.quality.infrastructure.persistence.QualityMetricMapper">
    <sql id="columns">
        id, source_id, task_id, run_id, metric_code,
        numerator, denominator, metric_value, measured_at, version
    </sql>
    <sql id="where">
        <where>
            <if test="query.sourceId != null">AND source_id = #{query.sourceId}</if>
            <if test="query.runId != null">AND run_id = #{query.runId}</if>
            <if test="query.metricCode != null">AND metric_code = #{query.metricCode}</if>
        </where>
    </sql>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM quality_metric_snapshot <include refid="where"/>
    </select>
    <select id="findPage"
            resultType="com.aacv.system.quality.infrastructure.persistence.QualityMetricRow">
        SELECT <include refid="columns"/>
        FROM quality_metric_snapshot
        <include refid="where"/>
        ORDER BY run_id DESC, metric_code, id
        LIMIT #{size} OFFSET #{offset}
    </select>
    <select id="findById"
            resultType="com.aacv.system.quality.infrastructure.persistence.QualityMetricRow">
        SELECT <include refid="columns"/>
        FROM quality_metric_snapshot
        WHERE id = #{metricId}
    </select>
    <select id="findSamples"
            resultType="com.aacv.system.quality.infrastructure.persistence.QualityIssueRow">
        SELECT id, raw_record_id, external_record_id,
               CAST(evidence_json AS CHAR CHARACTER SET utf8mb4) AS evidence_json,
               created_at
        FROM quality_issue_sample
        WHERE run_id = #{runId} AND metric_code = #{metricCode}
        ORDER BY id
        LIMIT #{limit}
    </select>
</mapper>
