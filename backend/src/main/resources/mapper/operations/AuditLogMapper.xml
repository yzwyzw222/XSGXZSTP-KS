<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aacv.system.operations.infrastructure.persistence.AuditLogMapper">
    <resultMap id="auditLogRow" type="com.aacv.system.operations.infrastructure.persistence.AuditLogRow">
        <id property="id" column="id"/>
        <result property="actorUserId" column="actor_user_id"/>
        <result property="action" column="action"/>
        <result property="targetType" column="target_type"/>
        <result property="targetId" column="target_id"/>
        <result property="result" column="result"/>
        <result property="traceId" column="trace_id"/>
        <result property="summaryJson" column="summary_json"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.aacv.system.operations.infrastructure.persistence.AuditLogRow"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO audit_log (
            actor_user_id,
            action,
            target_type,
            target_id,
            result,
            trace_id,
            summary_json,
            created_at
        )
        VALUES (
            #{actorUserId},
            #{action},
            #{targetType},
            #{targetId},
            #{result},
            #{traceId},
            #{summaryJson},
            #{createdAt}
        )
    </insert>

    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM audit_log
    </select>

    <select id="findPage" resultMap="auditLogRow">
        SELECT id,
               actor_user_id,
               action,
               target_type,
               target_id,
               result,
               trace_id,
               summary_json,
               created_at
        FROM audit_log
        ORDER BY created_at DESC, id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>
</mapper>
