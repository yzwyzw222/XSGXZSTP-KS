# AACV System 本地配置示例
# 复制为 .env 后仅在本机填写真实值；不要提交、分享或在日志中输出 .env。
# 本文件同时供 Spring Boot（Properties 语法）与 Docker Compose 读取，请保持 KEY=value 格式且不要添加 export 前缀。

# MySQL
AACV_DB_URL=jdbc:mysql://127.0.0.1:3306/aacv_system?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
AACV_DB_USERNAME=aacv
AACV_DB_PASSWORD=change-me-before-use

# Neo4j：Compose 与后端应使用同一组本地凭据
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-before-use
AACV_NEO4J_URI=bolt://127.0.0.1:7687
AACV_NEO4J_USERNAME=neo4j
AACV_NEO4J_PASSWORD=change-me-before-use
AACV_NEO4J_CONNECTION_TIMEOUT=5s
AACV_NEO4J_CONNECTION_ACQUISITION_TIMEOUT=5s
AACV_NEO4J_MAX_TRANSACTION_RETRY_TIME=5s

# 应用服务
AACV_SERVER_ADDRESS=127.0.0.1
AACV_SERVER_PORT=8080
AACV_EXPORT_ROOT=./.local/exports
AACV_GRAPH_OUTBOX_ENABLED=true
CROSSREF_CONTACT_EMAIL=
# OpenAlex可选密钥仅供后端出站请求使用，留空时使用匿名额度。
OPENALEX_API_KEY=

# 一次性初始管理员：仅在空数据库首次启动时临时启用，成功后立即恢复 false 并清空密码
AACV_BOOTSTRAP_ADMIN_ENABLED=false
AACV_BOOTSTRAP_ADMIN_USERNAME=aacv-admin
AACV_BOOTSTRAP_ADMIN_PASSWORD=

# 阶段 8 隔离容量环境
AACV_STAGE8_DB_USERNAME=aacv_stage8
AACV_STAGE8_DB_PASSWORD=change-me-before-use
AACV_STAGE8_DB_ROOT_PASSWORD=change-me-before-use
AACV_STAGE8_NEO4J_USERNAME=neo4j
AACV_STAGE8_NEO4J_PASSWORD=change-me-before-use

# 阶段 8 隔离恢复环境
AACV_STAGE8_RECOVERY_DB_USERNAME=aacv_stage8_recovery
AACV_STAGE8_RECOVERY_DB_PASSWORD=change-me-before-use
AACV_STAGE8_RECOVERY_DB_ROOT_PASSWORD=change-me-before-use
AACV_STAGE8_RECOVERY_NEO4J_USERNAME=neo4j
AACV_STAGE8_RECOVERY_NEO4J_PASSWORD=change-me-before-use
