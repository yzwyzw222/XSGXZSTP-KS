{
  "version": 1,
  "portalPort": 18000,
  "systems": [
    {
      "id": "crawler",
      "name": "学术成果信息采集及可视化系统",
      "description": "导入学者信息表，检索学术成果并展示学术关系、成果与背景图谱。",
      "capabilities": [
        "作者导入",
        "成果检索",
        "可视化分析"
      ],
      "status": "enabled",
      "message": "本地服务已启用，可登录使用。",
      "sourceBranch": "feature/Luo",
      "sourceSha": "3a0127019052c182962d6630981e0acec2d66d53",
      "runtime": {
        "acceptance": "docs/crawler-acceptance.md",
        "acceptanceSha": "3a0127019052c182962d6630981e0acec2d66d53",
        "dist": "systems/crawler/frontend/dist",
        "backendPort": 18083,
        "frontendPort": 5176,
        "contextPath": "/crawler",
        "readinessPath": "/crawler/actuator/health/readiness",
        "backend": {
          "executable": "java",
          "cwd": "systems/crawler/backend",
          "args": [
            "-Xms128m",
            "-Xmx512m",
            "-Djava.io.tmpdir={workspace}/.local/integration-runtime/crawler/tmp",
            "-Djdk.net.unixdomain.tmpdir={workspace}/.local/integration-runtime/crawler/tmp",
            "-jar",
            "target/system-0.0.1-SNAPSHOT.jar",
            "--spring.config.additional-location=file:{workspace}/.local/integration-runtime/crawler/application.properties"
          ]
        },
        "frontend": {
          "executable": "node",
          "cwd": "systems/crawler/frontend",
          "args": [
            "node_modules/vite/bin/vite.js",
            "--host",
            "127.0.0.1",
            "--port",
            "5176",
            "--strictPort",
            "--base",
            "/crawler/"
          ]
        }
      }
    }
  ]
}
